# Generated by Cargo
# will have compiled files and executables
debug/
target/

# This is a binary crate (cargo-leptos SSR server), so Cargo.lock is committed
# for reproducible builds. See https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# cargo-leptos build/watch artifacts (site-root; usually under target/, but ignore explicitly in case it's ever pointed elsewhere)
/target/site/

# Environment variables / secrets
.env
.env.*

# End-to-end tests (Node/Playwright) — has its own .gitignore, but keep root safe too
end2end/node_modules/
end2end/playwright-report/
end2end/test-results/

# Editor/IDE
.idea/
.vscode/
*.swp

# OS cruft
.DS_Store
